--- !u!114 &645087769
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 645087768}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 665303daf4284df418eb09d598e318d3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  gameTips:
  - "\uB0B4\uAC00 \uAD81\uAE08\uD574? \uAD81\uAE08\uD55C\uAC8C \uC788\uC73C\uBA74\n\uB9D0\uD48D\uC120\uC744
    \uB20C\uB7EC\uC11C \uB9D0\uC744 \uAC78\uC5B4\uBD10"
  - "\uC21C\uCC9C\uB9CC\uC758 \uAC2F\uBC8C \uC54C\uC544?\r\n\uAC70\uAE34 \uC0DD\uBA85\uC774
    \uD3ED\uBC1C\uD558\uB294 \uACF3\uC774\uC57C.\r\n\uC138\uACC4 5\uB300 \uC5F0\uC548
    \uC2B5\uC9C0 \uC911 \r\n\uD558\uB098\uB85C \uAF3D\uD790 \uC815\uB3C4\uB2C8\uAE4C "
  - "\uB3C4\uAC10\uC744 \uB204\uB974\uBA74 \uC6B0\uB9AC \uBA54\uCE74\uB4E4\uACFC\r\n\uC801\uB4E4\uC758
    \uC815\uBCF4\uB97C \uD655\uC778\uD560 \uC218 \uC788\uC5B4"
  - "\uC544\uC9C1\uB3C4 \uBED4\uD55C \uC5EC\uD589\uC9C0\uB97C \uCC3E\uACE0\uC788\uC5B4?\r\n\uC21C\uCC9C\uB9CC\uC73C\uB85C
    \uC640. \uC790\uC5F0\uC774 \uB9CC\uB4E0\r\n\uCD5C\uACE0\uC758 \uC791\uD488\uB4E4\uC774
    \uC788\uC5B4"
  - "\uC124\uC815 \uBC84\uD2BC\uC744 \uB204\uB974\uBA74 \r\n\uC2DC\uB044\uB7EC\uC6B4
    \uC18C\uB9AC\uB294 \uC904\uC77C \uC218 \uC788\uC5B4. \r\n\uB531\uD788 \uAC71\uC815\uD574\uC8FC\uB294\uAC74
    \uC544\uB2C8\uC57C..!"
  - "\uC21C\uCC9C\uB9CC \uC2B5\uC9C0, \uCC38 \uC88B\uC558\uC9C0..\r\n\uD2B9\uD788
    \uD574 \uC9C8 \uB158 S\uC790 \uBB3C\uAE38\uC740\r\n\uC815\uB9D0 \uCD5C\uACE0\uC600\uC5B4."
  - "\uC900\uBE44\uD574! \uACE7 \uBE44\uD589 \uC2DC\uC791\uD560\uAC70\uC57C.\r\n\uC624\uC5FC\uB41C
    \uC21C\uCC9C\uB9CC\uC744 \uB2E4\uC2DC\r\n\uC544\uB984\uB2F5\uAC8C \uB9CC\uB4E4\uC5B4\uC57C\uC9C0!"
  - "\uC804\uD22C\uC5D0 \uB3CC\uC785\uD558\uBA74 \uAF2D \r\n\uD504\uB85C\uD1A0\uCF5C
    \uBBF8\uC158\uC744 \uD074\uB9AC\uC5B4 \uD574\uBD10! \r\n\uD504\uB85C\uD1A0\uCF5C
    \uD569\uCCB4\uB97C \uD1B5\uD574 \r\n\uB354 \uAC15\uB825\uD574\uC9C8 \uC218 \uC788\uC5B4\r"
  - "\uB124\uAC00 \uC5F4\uC2EC\uD788 \uD574\uC900\uB2E4\uBA74 \uC774 \uAC8C\uC784,
    \r\n\uCD9C\uC2DC\uD560 \uC218 \uC788\uACA0\uB294\uAC78?"
  - "\uB10C \uB098\uC5D0\uAC8C \uCC38 \uAD00\uC2EC\uC774 \uB9CE\uAD6C\uB098..?"
  - "\uD751\uB450\uB8E8\uBBF8\uAC00 \uC21C\uCC9C\uB9CC\uC744 \uACA8\uC6B8\uBCC4\uAD81\uC73C\uB85C
    \uC37C\uB300. \uBA4B\uC9C0\uC9C0 \uC54A\uB2C8? \uADF8\uB9CC\uD07C \uC774 \uACF3\uC740
    \uBAA8\uB450\uC5D0\uAC8C \uADC0\uD55C \uACF3\uC774\uC57C."
  tipText: {fileID: 1027292426}
  fadeDuration: 0.2
