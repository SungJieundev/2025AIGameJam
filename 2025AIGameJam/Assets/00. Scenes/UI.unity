  m_Script: {fileID: 11500000, guid: 665303daf4284df418eb09d598e318d3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  gameTips:
  - "\uB0B4\uAC00 \uAD81\uAE08\uD574? \uAD81\uAE08\uD55C\uAC8C \uC788\uC73C\uBA74
    \uB098\uB97C \uB20C\uB7EC\uC11C \uB9D0\uC744 \uAC78\uC5B4\uBD10"
  - "\uC21C\uCC9C\uB9CC\uC758 \uAC2F\uBC8C \uC54C\uC544? \uAC70\uAE34 \uC0DD\uBA85\uC774
    \uD3ED\uBC1C\uD558\uB294 \uACF3\uC774\uC57C. \uC138\uACC4 5\uB300 \uC5F0\uC548
    \uC2B5\uC9C0 \uC911 \uD558\uB098\uB85C \uAF3D\uD790 \uC815\uB3C4\uB2C8\uAE4C
    \uB9D0 \uB2E4 \uD588\uC9C0."
  - "\uD765, \uADF8\uB807\uB2E4\uACE0 \uB108\uC5D0\uAC8C \uB531\uD788 \uAD00\uC2EC\uC788\uB294
    \uAC74 \uC544\uB0D0 -_-"
  - "\uBB50? \uB0B4\uAC00 \uC88B\uC544\uD558\uB294 \uAC70?... \uB10C \uBAB0\uB77C\uB3C4
    \uB3FC '\u3145'"
  - "\uB3C4\uAC10\uC744 \uB204\uB974\uBA74 \uC6B0\uB9AC \uB3D9\uB8CC\uB4E4\uACFC
    \uC801\uB4E4\uC744 \uBBF8\uB9AC \uBCFC \uC218 \uC788\uC5B4"
  - "\uB098\uC5D0\uAC8C \uC65C \uC774\uB807\uAC8C \uAD00\uC2EC\uC774 \uB9CE\uC740\uAC70\uC57C!
    \uC815\uB9D0 \uD53C\uACE4\uD558\uB2E4\uAD6C."
  - "\uC124\uC815 \uBC84\uD2BC\uC744 \uB204\uB974\uBA74 \uC2DC\uB044\uB7EC\uC6B4
    \uC18C\uB9AC\uB294 \uC904\uC77C \uC218 \uC788\uC5B4. \uAC71\uC815\uD574\uC8FC\uB294
    \uAC70 \uC544\uB2C8\uAC70\uB4E0??"
  tipText: {fileID: 1027292426}
  fadeDuration: 0.5
