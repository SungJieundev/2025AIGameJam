  m_text: "\uADF8\uB4E4\uC740 \uC790\uC2E0\uC758 \uC0B6\uC758 \uD130\uC804\uC778
    \uC21C\uCC9C\uB9CC\uC744 \uD30C\uAD34\uD558\uACE0, \uAC00\uC2A4\uC5D0 \uC911\uB3C5\uB418\uC5B4
    \uC21C\uCC9C\uB9CC\uC758 \uBED8\uC744 \uACF5\uACA9\uD558\uAE30 \uC2DC\uC791\uD588\uB2E4.\r\n\uADF8
    \uC21C\uAC04, \uB098\uC57D\uD55C \uB450\uAEBC\uBE44 \uD55C \uB9C8\uB9AC\uAC00
